# Google AI Studio key (https://aistudio.google.com/apikey) — primary Gemini auth
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODEL=gemini-flash-latest
GEMINI_TIMEOUT_MS=15000
# Firebase service account JSON (Project settings -> Service accounts -> Generate new private key)
GOOGLE_APPLICATION_CREDENTIALS=service-account.json
FIREBASE_PROJECT_ID=mamta-hackathon
# Urdu voice for Cloud Text-to-Speech
TTS_VOICE=ur-IN-Wavenet-A
# Fallback voice when Cloud TTS has no credentials: Gemini TTS (uses GEMINI_API_KEY)
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TTS_VOICE=Kore
# DEMO_MODE: true = if Gemini is down, typed answers use offline rules | force = no Wi-Fi: replay recorded demo responses
DEMO_MODE=true
# Set true to skip Firestore entirely (in-memory DB, auto-seeded)
USE_MEMORY_DB=false
